# Template only: copy to .env and put real keys THERE. Never put keys in this file.

# Which AI connection to use: "openai" (direct) or "openrouter"
AI_PROVIDER=openai

# --- OpenAI direct (AI_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-6.2-sol

# --- OpenRouter (AI_PROVIDER=openrouter) ---
OPENROUTER_API_KEY=
# Must be on the allowlist in tools/phase0/src/ai.ts (Anthropic / OpenAI / Google only)
OPENROUTER_MODEL=anthropic/claude-opus-5.5

POSTGRES_USER=planparse
POSTGRES_PASSWORD=planparse_dev
POSTGRES_DB=planparse
